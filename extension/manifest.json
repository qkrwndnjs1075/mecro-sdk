{
  "manifest_version": 3,
  "name": "mecro-sdk",
  "icons": {
    "16": "icons/ticket-16.png",
    "32": "icons/ticket-32.png",
    "48": "icons/ticket-48.png",
    "128": "icons/ticket-128.png"
  },
  "version": "0.2.0",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "description": "NOL 인터파크에서 예정된 일반예매의 오픈 시각을 확인하고 대기합니다.",
  "permissions": ["activeTab", "storage", "webNavigation", "scripting", "offscreen", "power"],
  "host_permissions": ["https://tickets.interpark.com/*", "https://nol.yanolja.com/ticket/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://nol.yanolja.com/ticket/products/*", "https://tickets.interpark.com/goods/*", "https://tickets.interpark.com/gates/ticket/*"],
    "js": [
      "providers/nol-interpark/selection.js",
      "providers/nol-interpark/upcoming.js",
      "providers/nol-interpark/booking.js",
      "providers/nol-interpark/wait.js"
    ]
  }, {
    "matches": ["https://tickets.interpark.com/*", "https://nol.yanolja.com/ticket/*"],
    "js": ["capture-source.js", "auto-capture.js"]
  }],
  "action": {
    "default_title": "mecro-sdk · NOL 인터파크",
    "default_popup": "popup.html"
  }
}
